{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    // `list[i]` and `record[key]` read as possibly `undefined`, as they can be at
    // runtime. Narrow, fall back with `??`, or — where the index is provably in
    // range — assert with `!` and say why. Tests use `nth()`/`defined()` from
    // `src/test-narrowing.ts`, which fail with a readable message instead.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Some modules under shared/ import each other with explicit `.ts` specifiers.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // Production source gets no ambient globals at all: not Vitest's, and not the
    // Node ones `@types/node` drags in transitively. Anything the browser bundle
    // uses has to be a real import or a DOM lib type. Test code opts back in via
    // tsconfig.test.json, which `npm run typecheck` runs as a second pass.
    "types": []
  },
  "include": ["src", "shared", "vite.config.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
