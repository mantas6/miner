{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["dist", "public", "test-results", "playwright-report"],
  "rules": {
    // Style the codebase already follows everywhere, pinned so it stays that way.
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    // The automatic JSX runtime (`"jsx": "react-jsx"`) means React is never
    // imported for JSX, and the components rely on that.
    "react/react-in-jsx-scope": "off",
    // Every overlay that can be one *is* a native `<dialog>` now (shop, info).
    // What is left are roles with no tag to prefer: the fuel gauge is a
    // `role="meter"` div wrapping an analog dial, and the canvas is a
    // `role="application"`.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Side-effect imports are how CSS modules and global stylesheets are pulled in.
    "import/no-unassigned-import": "off",
    // Factory modules (renderer, run) deliberately declare their helpers inside
    // the closure that owns the state, next to their only caller.
    "unicorn/consistent-function-scoping": "off",
    // Nested helpers intentionally re-take the outer name for the same value
    // (`ctx`, `save`, throwaway `_` destructuring holes).
    "no-shadow": "off",
    // `.sort()` is only ever called on freshly built arrays here, and the
    // suggested `toSorted()` is outside the ES2022 lib this project targets.
    "unicorn/no-array-sort": "off",
    // The audio controller owns one handler per media element event and detaches
    // it by assigning `null`, which needs the `on*` properties.
    "unicorn/prefer-add-event-listener": "off",
    // Sequentially awaiting inside a loop is the point in the polling tests.
    "no-await-in-loop": "off",
    // Vitest's `expect(value, message)` takes an assertion label as 2nd argument.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Tests assert inside loops over generated worlds; that is filtering, not the
    // "expect inside catch that may never run" anti-pattern this rule targets.
    "vitest/no-conditional-expect": "off",
    // Typing every `vi.fn()` is noise in tests that only assert call counts.
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      // Hook rules only where components live: `src/game/` has plain game
      // functions such as `useFuel()` that are not React hooks.
      "files": ["src/**/*.tsx"],
      "rules": {
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "error"
      }
    },
    {
      // The Playwright suite straddles both: the spec bodies run in Node, and the
      // callbacks they hand to `page.evaluate()` run in the page.
      "files": ["e2e/**/*.ts", "playwright.config.ts"],
      "env": { "browser": true, "node": true }
    },
    {
      // The agent harness is Node that ships callbacks into the page too: the
      // session evaluates `import('/src/agent/bridge.ts')` and rAF loops there.
      "files": ["agent/**/*.ts"],
      "env": { "browser": true, "node": true }
    }
  ]
}
